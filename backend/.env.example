RIOT_API_KEY=riot_api_key_here
GEMINI_API_KEY=key_here

# Redis (optional — set REDIS_ENABLED=true to activate)
# Local Docker: REDIS_HOST=localhost (Python on host) or redis (API in Compose), REDIS_SSL=false
# Redis Cloud: REDIS_HOST=<cloud-host>, REDIS_PORT=<cloud-port>, REDIS_PASSWORD=<password>, REDIS_SSL=true
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# Logging
LOG_LEVEL=info

# API Configuration
API_TITLE=REST API Template
API_VERSION=1.0.0
API_DESCRIPTION=A template for building REST APIs with FastAPI
